generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  VIEWER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdProjects Project[] @relation("ProjectsCreated")
  reportedTickets Ticket[]  @relation("ReportedTickets")
  assignedTickets Ticket[]  @relation("AssignedTickets")
  comments        Comment[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById Int
  createdBy   User @relation("ProjectsCreated", fields: [createdById], references: [id], onDelete: Restrict)

  tickets Ticket[]
}

model Ticket {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  projectId  Int
  reporterId Int
  assigneeId Int?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReportedTickets", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee User?   @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketId Int
  userId   Int

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── AI Layer ──────────────────────────────────────────────────────────────────

model PromptVersion {
  id           Int      @id @default(autoincrement())
  name         String   // e.g. "ticket_summarize", "suggest_resolution"
  version      Int      @default(1)
  isActive     Boolean  @default(false)
  systemPrompt String   @db.Text
  userTemplate String   @db.Text
  modelId      String   @default("gpt-4o-mini")
  maxTokens    Int      @default(512)
  temperature  Float    @default(0.3)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs LLMLog[]

  @@unique([name, version])
  @@index([name, isActive])
}

model LLMLog {
  id              Int           @id @default(autoincrement())
  promptVersion   PromptVersion @relation(fields: [promptVersionId], references: [id])
  promptVersionId Int
  ticketId        Int?
  inputSnapshot   String        @db.Text
  rawOutput       String        @db.Text
  inputTokens     Int
  outputTokens    Int
  latencyMs       Int
  scoreRelevance  Float?
  scoreCoherence  Float?
  scoreLengthOk   Float?
  scoreOverall    Float?
  evalStatus      String        @default("pending") // pending | passed | flagged
  createdAt       DateTime      @default(now())

  @@index([promptVersionId])
  @@index([ticketId])
  @@index([evalStatus])
}
